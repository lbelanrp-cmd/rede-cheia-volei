rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function membroRef(t) { return /databases/$(database)/documents/times/$(t)/membros/$(request.auth.uid); }
    function membro(t) { return logado() && exists(membroRef(t)); }
    function papel(t) { return get(membroRef(t)).data.papel; }
    function gestor(t) { return membro(t) && papel(t) in ['presidente', 'vicepresidente', 'capitao', 'capita', 'professor']; }
    function presidente(t) { return membro(t) && papel(t) == 'presidente'; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // financeiro: só o presidente e o(a) tesoureiro(a)
    function fin(t) { return presidente(t) || (membro(t) && papel(t) == 'tesoureiro'); }
    // diretoria: vê as assembleias
    function diretoria(t) { return gestor(t) || (membro(t) && papel(t) in ['tesoureiro', 'diretoria']); }

    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    match /convites/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado()
        && request.resource.data.criadoPor == request.auth.uid
        && ((request.resource.data.papel == 'atleta' && gestor(request.resource.data.time))
            || presidente(request.resource.data.time));
      allow delete: if logado() && (
        exists(/databases/$(database)/documents/times/$(resource.data.time)/membros/$(request.auth.uid))
        || existsAfter(/databases/$(database)/documents/times/$(resource.data.time)/membros/$(request.auth.uid)));
    }

    match /times/{t} {
      allow read: if membro(t);
      allow create: if logado() && request.resource.data.criadoPor == request.auth.uid;
      allow update: if gestor(t);
      allow delete: if presidente(t);

      match /membros/{uid} {
        allow read: if membro(t);

        function conviteOk() {
          let c = get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data;
          return c.time == t
            && c.papel == request.resource.data.papel
            && c.carta == request.resource.data.carta;
        }

        allow create: if logado() && request.auth.uid == uid && (
          (request.resource.data.papel == 'presidente'
            && getAfter(/databases/$(database)/documents/times/$(t)).data.criadoPor == request.auth.uid)
          || (conviteOk() && !request.resource.data.keys().hasAny(['financeiro'])));

        allow update: if presidente(t)
          || (request.auth.uid == uid && mudou().hasOnly(['nome']))
          // atleta liga a carta que ele mesmo acabou de criar
          || (request.auth.uid == uid && resource.data.carta == null
              && mudou().hasOnly(['carta'])
              && getAfter(/databases/$(database)/documents/times/$(t)/jogadores/$(request.resource.data.carta)).data.donoUid == request.auth.uid);

        allow delete: if presidente(t) || (logado() && request.auth.uid == uid);
      }

      // Liga: agenda (treinos, eventos, assembleias) — só a comissão edita
      match /agenda/{a} {
        allow read: if membro(t);
        allow create, update: if gestor(t) && request.resource.data.get('tipo', '') != 'assembleia';
        allow delete: if gestor(t);
      }
      // Liga: assembleias — só a diretoria vê
      match /assembleias/{a} {
        allow read: if diretoria(t);
        allow write: if gestor(t);
      }
      // Liga: cada membro confirma ou desmarca apenas a própria presença no treino
      match /confirmacoes/{c} {
        allow read: if membro(t);
        allow create, update: if membro(t)
          && request.resource.data.uid == request.auth.uid
          && c == request.resource.data.inst + '_' + request.auth.uid;
        allow delete: if gestor(t) || (membro(t) && resource.data.uid == request.auth.uid);
      }
      // Liga: mural de avisos — só a comissão publica e apaga
      match /avisos/{v} {
        allow read: if membro(t);
        allow create: if gestor(t) && request.resource.data.autorUid == request.auth.uid;
        allow update, delete: if gestor(t);
      }

      // Liga: financeiro — ninguém além do presidente e da tesouraria lê ou escreve
      match /fin_config/{d} {
        allow read, write: if fin(t);
      }
      match /fin_lanc/{l} {
        allow read, write: if fin(t);
      }
      match /fin_comp/{c} {
        allow read, write: if fin(t);
      }
      // Liga: dados do Pix que o atleta precisa para pagar (sem valores do caixa)
      match /pix/{d} {
        allow read: if membro(t);
        allow write: if fin(t);
      }
      // Liga: pagamentos informados pelo atleta e confirmados pela tesouraria
      match /pag_informes/{i} {
        allow read: if fin(t) || (membro(t) && resource.data.uid == request.auth.uid);
        allow create: if fin(t) || (membro(t) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pendente');
        allow update: if fin(t);
        allow delete: if fin(t) || (membro(t) && resource.data.uid == request.auth.uid && resource.data.status == 'pendente');
      }
      match /pag_comp/{i} {
        allow read: if fin(t) || (membro(t) && get(/databases/$(database)/documents/times/$(t)/pag_informes/$(i)).data.uid == request.auth.uid);
        allow create: if membro(t) && getAfter(/databases/$(database)/documents/times/$(t)/pag_informes/$(i)).data.uid == request.auth.uid;
        allow delete: if fin(t);
      }

      // Torneio: todos do time acompanham; só a comissão monta e marca os placares
      match /torneios/{x} {
        allow read: if membro(t);
        allow write: if gestor(t);
      }

      match /jogadores/{j} {
        allow read: if membro(t);
        allow create: if gestor(t)
          // atleta cria a própria carta: atributos ficam em 50 até a comissão avaliar
          || (membro(t) && get(membroRef(t)).data.carta == null
              && request.resource.data.donoUid == request.auth.uid
              && request.resource.data.attrs == [50, 50, 50, 50, 50, 50]
              && request.resource.data.avaliado == false
              && request.resource.data.presente == false
              && request.resource.data.tipo == 'avulso'
              && request.resource.data.keys().hasOnly(['nome', 'genero', 'pos', 'pos2', 'numero', 'foto', 'tipo', 'attrs', 'presente', 'avaliado', 'donoUid']));
        allow delete: if gestor(t);
        // comissão edita tudo; atleta edita os próprios dados, foto e presença, nunca os atributos
        allow update: if gestor(t)
          || (membro(t) && get(membroRef(t)).data.carta == j
              && mudou().hasOnly(['foto', 'presente', 'nome', 'numero', 'pos', 'pos2', 'genero']));
      }
    }
  }
}
